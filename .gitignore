# FRIDAY — Git Ignore

# ── Secrets ────────────────────────────────────────────────────
.env

# ── Python cache ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# ── Virtual environments ───────────────────────────────────────
venv/
.venv/
env/

# ── Runtime artifacts ──────────────────────────────────────────
screenshots/
generated_images/
logs/

# ── OS files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
