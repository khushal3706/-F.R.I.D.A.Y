# ─────────────────────────────────────────────────────────────────────────────
# FRIDAY — Environment Variables Template  (100% FREE STACK)
# Copy this to ".env" and fill in your Gemini key.
# NEVER commit your .env to version control.
# ─────────────────────────────────────────────────────────────────────────────
#
#  Cost breakdown:
#    Gemini 1.5 Flash  →  FREE (AI Studio: 15 RPM / 1M tokens per day)
#    DuckDuckGo        →  FREE (no key required)
#    Pollinations.ai   →  FREE (no key required)
#    MSS + OpenCV      →  FREE (local, no API)
#    PyAutoGUI         →  FREE (local, no API)
#
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini — get free key at https://aistudio.google.com/apikey ───────
GEMINI_API_KEY=your-gemini-key-here

# ── Hugging Face (optional) — free inference API ─────────────────────────────
# HF_API_TOKEN=hf_your_token_here

# ── Ollama (optional) — local LLM, no key needed ─────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
